APP_NAME=FormAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=formai
DB_USERNAME=formai
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@formai.local"
MAIL_FROM_NAME="${APP_NAME}"

AI_PROVIDER=gemini
# Crie a chave no Google AI Studio e mantenha-a somente no servidor.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GRADING_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT=45
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TEMPERATURE=0.2
GEMINI_INPUT_USD_PER_MTOK=0
GEMINI_OUTPUT_USD_PER_MTOK=0

# OpenAI preservada como alternativa inativa.
# Para reativar: remova os comentários abaixo, configure a chave e use AI_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_GRADING_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
# OPENAI_TIMEOUT=45
# OPENAI_MAX_OUTPUT_TOKENS=1200
# OPENAI_INPUT_USD_PER_MTOK=2.00
# OPENAI_OUTPUT_USD_PER_MTOK=12.00

FORM_AI_PROMPT_VERSION=1
FORM_AI_TEACHER_INSTRUCTION_MAX=2000
FORM_AI_QUEUE_LAG_ALERT_SECONDS=300
FORM_AI_GRADING_TIMEOUT_SECONDS=180
FORM_AI_PASSWORD_MIN_LENGTH=6
