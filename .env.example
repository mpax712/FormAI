APP_NAME=FormAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
TRUSTED_PROXIES=*
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Copie a URL do Session Pooler (porta 5432) em Supabase > Connect.
# Nunca inclua credenciais reais neste arquivo nem em commits.
DB_CONNECTION=pgsql
# Habilite somente depois de configurar e iniciar o MySQL local.
DB_FALLBACK_ENABLED=false
DB_FALLBACK_CONNECTION=mysql_local

DB_URL=
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
DB_APPLICATION_NAME=formai

DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=formai
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=12345

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database

# Desenvolvimento: os códigos de verificação e os links de recuperação ficam em storage/logs/laravel.log.
# Produção: troque MAIL_MAILER para smtp e configure MAIL_URL, ou use MAIL_HOST/MAIL_PORT/etc.
MAIL_MAILER=log
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=null
MAIL_FROM_ADDRESS="noreply@formai.local"
MAIL_FROM_NAME="${APP_NAME}"

AI_PROVIDER=openrouter
# OpenRouter: chave somente no servidor; limites de consumo definidos pela aplicação.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GRADING_MODEL=stealth/space-bunny-alpha
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_INPUT_USD_PER_MTOK=0
OPENROUTER_OUTPUT_USD_PER_MTOK=0

# Gemini disponível como alternativa opcional.
# Crie a chave no Google AI Studio e mantenha-a somente no servidor.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GRADING_MODEL=gemini-3.7-flash
GEMINI_CONNECT_TIMEOUT=5
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TEMPERATURE=0.2
GEMINI_THINKING_LEVEL=low
GEMINI_INPUT_USD_PER_MTOK=0
GEMINI_OUTPUT_USD_PER_MTOK=0

# OpenAI preservada como alternativa inativa.
# Para reativar: remova os comentários abaixo, configure a chave e use AI_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_GRADING_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
# OPENAI_TIMEOUT=45
# OPENAI_MAX_OUTPUT_TOKENS=1200
# OPENAI_INPUT_USD_PER_MTOK=2.00
# OPENAI_OUTPUT_USD_PER_MTOK=12.00

FORM_AI_PROMPT_VERSION=2
FORM_AI_TEACHER_INSTRUCTION_MAX=4001
FORM_AI_QUEUE_LAG_ALERT_SECONDS=300
FORM_AI_GRADING_TIMEOUT_SECONDS=300
FORM_AI_PASSWORD_MIN_LENGTH=6
FORM_AI_EMAIL_CODE_MINUTES=15
FORM_AI_EMAIL_CODE_ATTEMPTS=5

# Perfis de IA: OpenRouter habilitado abaixo; alternativas opcionais (docs/ai-grading.md).
AI_QUEUE_TIMEOUT_SECONDS=86400
AI_RETRY_COOLDOWN_SECONDS=300
AI_GEMINI_RPM=0
AI_GEMINI_RPH=0
AI_GEMINI_RPD=0
AI_GEMINI_TPM=0
AI_GEMINI_CONCURRENCY=1
AI_OPENAI_RPM=0
AI_OPENAI_RPH=0
AI_OPENAI_RPD=0
AI_OPENAI_TPM=0
AI_OPENAI_CONCURRENCY=1

AI_ECONOMY_COST_CEILING_USD=1.00
AI_ECONOMY_GEMINI_ENABLED=false
AI_ECONOMY_GEMINI_MODEL=
AI_ECONOMY_GEMINI_EFFORT=
AI_ECONOMY_GEMINI_SUPPORTED_EFFORTS=
AI_ECONOMY_GEMINI_STRUCTURED_OUTPUT=false
AI_ECONOMY_GEMINI_MAX_OUTPUT_TOKENS=0
AI_ECONOMY_GEMINI_INPUT_USD_PER_MTOK=
AI_ECONOMY_GEMINI_OUTPUT_USD_PER_MTOK=
AI_ECONOMY_GEMINI_QUOTA_GROUP=gemini
AI_ECONOMY_OPENAI_ENABLED=false
AI_ECONOMY_OPENAI_MODEL=
AI_ECONOMY_OPENAI_EFFORT=
AI_ECONOMY_OPENAI_SUPPORTED_EFFORTS=
AI_ECONOMY_OPENAI_STRUCTURED_OUTPUT=false
AI_ECONOMY_OPENAI_MAX_OUTPUT_TOKENS=0
AI_ECONOMY_OPENAI_INPUT_USD_PER_MTOK=
AI_ECONOMY_OPENAI_OUTPUT_USD_PER_MTOK=
AI_ECONOMY_OPENAI_QUOTA_GROUP=openai

AI_BALANCED_COST_CEILING_USD=1.00
AI_BALANCED_GEMINI_ENABLED=false
AI_BALANCED_GEMINI_MODEL=
AI_BALANCED_GEMINI_EFFORT=
AI_BALANCED_GEMINI_SUPPORTED_EFFORTS=
AI_BALANCED_GEMINI_STRUCTURED_OUTPUT=false
AI_BALANCED_GEMINI_MAX_OUTPUT_TOKENS=0
AI_BALANCED_GEMINI_INPUT_USD_PER_MTOK=
AI_BALANCED_GEMINI_OUTPUT_USD_PER_MTOK=
AI_BALANCED_GEMINI_QUOTA_GROUP=gemini
AI_BALANCED_OPENAI_ENABLED=false
AI_BALANCED_OPENAI_MODEL=
AI_BALANCED_OPENAI_EFFORT=
AI_BALANCED_OPENAI_SUPPORTED_EFFORTS=
AI_BALANCED_OPENAI_STRUCTURED_OUTPUT=false
AI_BALANCED_OPENAI_MAX_OUTPUT_TOKENS=0
AI_BALANCED_OPENAI_INPUT_USD_PER_MTOK=
AI_BALANCED_OPENAI_OUTPUT_USD_PER_MTOK=
AI_BALANCED_OPENAI_QUOTA_GROUP=openai

AI_ADVANCED_COST_CEILING_USD=1.00
AI_ADVANCED_GEMINI_ENABLED=false
AI_ADVANCED_GEMINI_MODEL=
AI_ADVANCED_GEMINI_EFFORT=
AI_ADVANCED_GEMINI_SUPPORTED_EFFORTS=
AI_ADVANCED_GEMINI_STRUCTURED_OUTPUT=false
AI_ADVANCED_GEMINI_MAX_OUTPUT_TOKENS=0
AI_ADVANCED_GEMINI_INPUT_USD_PER_MTOK=
AI_ADVANCED_GEMINI_OUTPUT_USD_PER_MTOK=
AI_ADVANCED_GEMINI_QUOTA_GROUP=gemini
AI_ADVANCED_OPENAI_ENABLED=false
AI_ADVANCED_OPENAI_MODEL=
AI_ADVANCED_OPENAI_EFFORT=
AI_ADVANCED_OPENAI_SUPPORTED_EFFORTS=
AI_ADVANCED_OPENAI_STRUCTURED_OUTPUT=false
AI_ADVANCED_OPENAI_MAX_OUTPUT_TOKENS=0
AI_ADVANCED_OPENAI_INPUT_USD_PER_MTOK=
AI_ADVANCED_OPENAI_OUTPUT_USD_PER_MTOK=
AI_ADVANCED_OPENAI_QUOTA_GROUP=openai

# Space Bunny Alpha nos três perfis, com raciocínio e JSON instruído pelo servidor.
AI_OPENROUTER_RPM=10
AI_OPENROUTER_RPH=50
AI_OPENROUTER_RPD=50
AI_OPENROUTER_TPM=100000
AI_OPENROUTER_CONCURRENCY=1
AI_ECONOMY_OPENROUTER_ENABLED=true
AI_ECONOMY_OPENROUTER_MODEL=stealth/space-bunny-alpha
AI_ECONOMY_OPENROUTER_EFFORT=enabled
AI_ECONOMY_OPENROUTER_SUPPORTED_EFFORTS=enabled
AI_ECONOMY_OPENROUTER_STRUCTURED_OUTPUT=true
AI_ECONOMY_OPENROUTER_MAX_OUTPUT_TOKENS=8192
AI_ECONOMY_OPENROUTER_INPUT_USD_PER_MTOK=0
AI_ECONOMY_OPENROUTER_OUTPUT_USD_PER_MTOK=0
AI_ECONOMY_OPENROUTER_QUOTA_GROUP=openrouter
AI_BALANCED_OPENROUTER_ENABLED=true
AI_BALANCED_OPENROUTER_MODEL=stealth/space-bunny-alpha
AI_BALANCED_OPENROUTER_EFFORT=enabled
AI_BALANCED_OPENROUTER_SUPPORTED_EFFORTS=enabled
AI_BALANCED_OPENROUTER_STRUCTURED_OUTPUT=true
AI_BALANCED_OPENROUTER_MAX_OUTPUT_TOKENS=8192
AI_BALANCED_OPENROUTER_INPUT_USD_PER_MTOK=0
AI_BALANCED_OPENROUTER_OUTPUT_USD_PER_MTOK=0
AI_BALANCED_OPENROUTER_QUOTA_GROUP=openrouter
AI_ADVANCED_OPENROUTER_ENABLED=true
AI_ADVANCED_OPENROUTER_MODEL=stealth/space-bunny-alpha
AI_ADVANCED_OPENROUTER_EFFORT=enabled
AI_ADVANCED_OPENROUTER_SUPPORTED_EFFORTS=enabled
AI_ADVANCED_OPENROUTER_STRUCTURED_OUTPUT=true
AI_ADVANCED_OPENROUTER_MAX_OUTPUT_TOKENS=8192
AI_ADVANCED_OPENROUTER_INPUT_USD_PER_MTOK=0
AI_ADVANCED_OPENROUTER_OUTPUT_USD_PER_MTOK=0
AI_ADVANCED_OPENROUTER_QUOTA_GROUP=openrouter

# O endpoint da Space Bunny não respeita JSON Schema; use JSON Object com validação local.
OPENROUTER_RESPONSE_FORMAT=json_object
AI_ECONOMY_OPENROUTER_RESPONSE_FORMAT=json_object
AI_BALANCED_OPENROUTER_RESPONSE_FORMAT=json_object
AI_ADVANCED_OPENROUTER_RESPONSE_FORMAT=json_object
